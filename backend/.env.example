# Application Auth Token
API_TOKEN=your_secure_token

# ==============================================================================
# Example 1: NVIDIA NIM (Nemotron-class recommended settings)
# ==============================================================================
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=nvapi-your_nvidia_api_key_here
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
MODEL_TEMPERATURE=1.0
MODEL_TOP_P=0.95
# Pass provider-specific payload parameters (e.g. toggle thinking mode and budget for Nemotron)
MODEL_EXTRA_BODY={"reasoning_budget": 512, "chat_template_kwargs": {"enable_thinking": true, "low_effort": true}}

# ==============================================================================
# Example 2: OpenAI / Compatible Providers (Groq, Krutrim, Ollama, etc.)
# ==============================================================================
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your_openai_api_key_here
# MODEL_NAME=openai/gpt-oss120b
# MODEL_TEMPERATURE=0.2
